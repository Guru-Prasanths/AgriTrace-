# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:5500
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agritrace

# Blockchain deployment only. NEVER put this private key in frontend files.
# Use a dedicated testnet wallet with no real funds.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Optional frontend RPC used for read-only calls. Public RPC URLs are not secrets.
# Paste this value into frontend/js/blockchain.js as AGRITRACE.SEPOLIA_RPC_URL.
FRONTEND_SEPOLIA_RPC_URL=https://rpc.sepolia.org
